PORT=3000
HOST=127.0.0.1
BASE_URL=http://127.0.0.1:3000

# Microsoft Entra ID / Outlook OAuth
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=replace-with-client-secret
MS_TENANT=common
MS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback

# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Development only. Enables /auth/dev when Microsoft credentials are not ready.
ALLOW_DEV_LOGIN=true
